# StampGrade environment
# Copy to .env.local and fill in. Every one of these is OPTIONAL —
# the site builds, deploys and grades sites correctly with none of them set.
# All are server-only. Never prefix any of these with NEXT_PUBLIC_.

# --- Anonymous scan log (optional) ---------------------------------
# Records domain/score/grade per scan. Nothing on the site reads this yet —
# it exists so a real "sites graded" figure has history behind it when we
# start showing one. Without these, nothing is logged and nothing breaks.
# Expects a table:
#   create table scans (
#     id bigint generated always as identity primary key,
#     domain text not null,
#     score int not null,
#     grade text not null,
#     created_at timestamptz not null default now()
#   );
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Transactional email (optional, not yet used) -------------------
# Reserved for SCHEDULED_RESCANS alerts (roadmap: Coming Soon).
# Nothing in the current build sends mail.
RESEND_API_KEY=
